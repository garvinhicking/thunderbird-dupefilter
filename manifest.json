{
  "manifest_version": 2,
  "name": "Show Dupes",
  "description": "Groups messages of the current folder whose subject occurs more than 3 times, sorted by number of occurrences.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "show-dupes@extension",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Show dupes of the current folder",
    "default_label": "Show dupes",
    "default_icon": "icons/dupes.svg",
    "default_area": "maintoolbar"
  },
  "icons": {
    "32": "icons/dupes.svg",
    "64": "icons/dupes.svg"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "menus"
  ]
}
